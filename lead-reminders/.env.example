PORT=8080
# Shared secret; the Google Sheet script sends it in the X-Secret header
LEAD_SECRET=change-me-to-a-long-random-string
# Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Any string you choose; enter the same one in Meta's webhook settings
WA_VERIFY_TOKEN=
WA_API_VERSION=v21.0
# Prefixed to 10-digit numbers
DEFAULT_COUNTRY_CODE=91
# 1 = log messages instead of sending
DRY_RUN=1
